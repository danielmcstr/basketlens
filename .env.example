# ==============================================================================
# BasketLens — Configuração de Ambiente Local (Docker Compose + Polars)
# Copie para `.env` se desejar sobrescrever os padrões de `basketlens.config`
# ==============================================================================

# --- Diretório da Base The Complete Journey ---
BASKETLENS_DATASET_DIR=dataset

# --- MongoDB (Document Store: Perfil 360º) ---
BASKETLENS_MONGO_HOST=localhost
BASKETLENS_MONGO_PORT=27017
BASKETLENS_MONGO_DB=basketlens
BASKETLENS_MONGO_URI=mongodb://localhost:27017

# --- Apache Cassandra (Wide-Column Store: Histórico Transacional e Causal) ---
BASKETLENS_CASSANDRA_HOST=localhost
BASKETLENS_CASSANDRA_PORT=9042
BASKETLENS_CASSANDRA_KEYSPACE=basketlens
BASKETLENS_CASSANDRA_CONCURRENCY=64

# --- Redis (Key-Value Speed Layer: Campanhas, Cupons Ativos e Cache-Aside) ---
BASKETLENS_REDIS_HOST=localhost
BASKETLENS_REDIS_PORT=6379
BASKETLENS_REDIS_DB=0

# --- Parâmetros Operacionais de Ingestão e Simulação (Event Replay) ---
# Tamanho do lote de leitura/escrita streaming via Polars
BASKETLENS_BATCH_SIZE=50000
# Quantidade de cestas recentes mantidas no documento MongoDB (Subset Pattern)
BASKETLENS_RECENT_BASKETS_LIMIT=5
# Dia de referência ("agora") ancorado no estudo de caso John Smith (household_key=208, PDF pág. 2)
BASKETLENS_REFERENCE_DAY=650
# Último dia completo do dataset (Modo A: Ingestão Completa)
BASKETLENS_FULL_CUTOFF_DAY=711
# Fator de compressão temporal para cálculo do TTL no Redis (1 dia do dataset = N segundos reais)
BASKETLENS_SECONDS_PER_DAY=5
# TTL em segundos para o Cache-Aside do perfil 360º (`profile:{household_key}`)
BASKETLENS_PROFILE_TTL_SECONDS=60
# Domicílio padrão do estudo de caso oficial da dunnhumby (John Smith)
BASKETLENS_CASE_STUDY_HOUSEHOLD=208
